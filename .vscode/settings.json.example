{
  "yaml.schemas": {
    // Local schema file (relative to workspace root)
    "./schemas/scriptrunner-v1alpha1.json": [
      "*scriptrunner*.yaml",
      "config/samples/*.yaml"
    ]

    // Or use a hosted schema URL:
    // "https://your-company.com/schemas/scriptrunner-v1alpha1.json": [
    //   "*scriptrunner*.yaml"
    // ]
  },
  "yaml.customTags": [
    "!Reference"
  ],
  "files.associations": {
    "*.scriptrunner.yaml": "yaml",
    "*.scriptrunner.yml": "yaml"
  }
}
