package controller

import (
	"context"
	"fmt"
	"time"

	batchv1 "k8s.io/api/batch/v1"
	corev1 "k8s.io/api/core/v1"
	"k8s.io/apimachinery/pkg/api/errors"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/apimachinery/pkg/runtime"
	"k8s.io/apimachinery/pkg/util/wait"
	"k8s.io/client-go/kubernetes"
	"k8s.io/client-go/tools/cache"
	"k8s.io/client-go/util/workqueue"
	"k8s.io/klog/v2"

	scriptrunnerv1alpha1 "github.com/kylegalloway/scriptrunner/pkg/apis/scriptrunner/v1alpha1"
	clientset "github.com/kylegalloway/scriptrunner/pkg/generated/clientset/versioned"
	informers "github.com/kylegalloway/scriptrunner/pkg/generated/informers/externalversions/scriptrunner/v1alpha1"
	listers "github.com/kylegalloway/scriptrunner/pkg/generated/listers/scriptrunner/v1alpha1"
)

const (
	// DefaultImage is the default container image for the job
	DefaultImage = "busybox:latest"

	// DefaultScript is the default script to run
	DefaultScript = `#!/bin/sh
echo "Starting script execution..."
echo "Inputs received:"
env | grep INPUT_ | sort
echo "Script completed successfully!"
`
)

// Controller is the controller implementation for ScriptRunner resources
type Controller struct {
	// kubeclientset is a standard kubernetes clientset
	kubeclientset kubernetes.Interface
	// scriptrunnerClientset is a clientset for our own API group
	scriptrunnerClientset clientset.Interface

	scriptRunnersLister listers.ScriptRunnerLister
	scriptRunnersSynced cache.InformerSynced

	// workqueue is a rate limited work queue. This is used to queue work to be
	// processed instead of performing it as soon as a change happens.
	workqueue workqueue.RateLimitingInterface

	scheme *runtime.Scheme
}

// NewController returns a new ScriptRunner controller
func NewController(
	kubeclientset kubernetes.Interface,
	scriptrunnerClientset clientset.Interface,
	scriptRunnerInformer informers.ScriptRunnerInformer,
	scheme *runtime.Scheme) *Controller {

	controller := &Controller{
		kubeclientset:         kubeclientset,
		scriptrunnerClientset: scriptrunnerClientset,
		scriptRunnersLister:   scriptRunnerInformer.Lister(),
		scriptRunnersSynced:   scriptRunnerInformer.Informer().HasSynced,
		workqueue:             workqueue.NewNamedRateLimitingQueue(workqueue.DefaultControllerRateLimiter(), "ScriptRunners"),
		scheme:                scheme,
	}

	klog.Info("Setting up event handlers")
	// Set up an event handler for when ScriptRunner resources change
	scriptRunnerInformer.Informer().AddEventHandler(cache.ResourceEventHandlerFuncs{
		AddFunc: controller.enqueueScriptRunner,
		UpdateFunc: func(old, new interface{}) {
			controller.enqueueScriptRunner(new)
		},
	})

	return controller
}

// Run will set up the event handlers for types we are interested in, as well
// as syncing informer caches and starting workers. It will block until stopCh
// is closed, at which point it will shutdown the workqueue and wait for
// workers to finish processing their current work items.
func (c *Controller) Run(workers int, stopCh <-chan struct{}) error {
	defer c.workqueue.ShutDown()

	// Start the informer factories to begin populating the informer caches
	klog.Info("Starting ScriptRunner controller")

	// Wait for the caches to be synced before starting workers
	klog.Info("Waiting for informer caches to sync")
	if ok := cache.WaitForCacheSync(stopCh, c.scriptRunnersSynced); !ok {
		return fmt.Errorf("failed to wait for caches to sync")
	}

	klog.Info("Starting workers")
	// Launch workers to process ScriptRunner resources
	for i := 0; i < workers; i++ {
		go wait.Until(c.runWorker, time.Second, stopCh)
	}

	klog.Info("Started workers")
	<-stopCh
	klog.Info("Shutting down workers")

	return nil
}

// runWorker is a long-running function that will continually call the
// processNextWorkItem function in order to read and process a message on the
// workqueue.
func (c *Controller) runWorker() {
	for c.processNextWorkItem() {
	}
}

// processNextWorkItem will read a single work item off the workqueue and
// attempt to process it, by calling the syncHandler.
func (c *Controller) processNextWorkItem() bool {
	obj, shutdown := c.workqueue.Get()

	if shutdown {
		return false
	}

	// We wrap this block in a func so we can defer c.workqueue.Done.
	err := func(obj interface{}) error {
		defer c.workqueue.Done(obj)
		var key string
		var ok bool

		if key, ok = obj.(string); !ok {
			c.workqueue.Forget(obj)
			klog.Errorf("expected string in workqueue but got %#v", obj)
			return nil
		}

		if err := c.syncHandler(key); err != nil {
			c.workqueue.AddRateLimited(key)
			return fmt.Errorf("error syncing '%s': %s, requeuing", key, err.Error())
		}

		c.workqueue.Forget(obj)
		klog.Infof("Successfully synced '%s'", key)
		return nil
	}(obj)

	if err != nil {
		klog.Error(err)
		return true
	}

	return true
}

// syncHandler compares the actual state with the desired, and attempts to
// converge the two. It then updates the Status block of the ScriptRunner resource
// with the current status of the resource.
func (c *Controller) syncHandler(key string) error {
	// Convert the namespace/name string into a distinct namespace and name
	namespace, name, err := cache.SplitMetaNamespaceKey(key)
	if err != nil {
		klog.Errorf("invalid resource key: %s", key)
		return nil
	}

	// Get the ScriptRunner resource with this namespace/name
	scriptRunner, err := c.scriptRunnersLister.ScriptRunners(namespace).Get(name)
	if err != nil {
		if errors.IsNotFound(err) {
			klog.Infof("ScriptRunner '%s' in work queue no longer exists", key)
			return nil
		}
		return err
	}

	// Check if Job already exists
	if scriptRunner.Status.JobName != "" {
		klog.Infof("Job already exists for ScriptRunner '%s': %s", key, scriptRunner.Status.JobName)
		return nil
	}

	// Create the Job
	jobName := fmt.Sprintf("%s-job", scriptRunner.Name)
	job := c.newJob(scriptRunner, jobName)

	klog.Infof("Creating Job %s for ScriptRunner %s", jobName, key)
	_, err = c.kubeclientset.BatchV1().Jobs(namespace).Create(context.TODO(), job, metav1.CreateOptions{})
	if err != nil {
		if errors.IsAlreadyExists(err) {
			klog.Infof("Job %s already exists", jobName)
		} else {
			return err
		}
	}

	// Update ScriptRunner status
	return c.updateScriptRunnerStatus(scriptRunner, jobName, "JobCreated", "Job created successfully")
}

// newJob creates a new Job for a ScriptRunner resource
func (c *Controller) newJob(scriptRunner *scriptrunnerv1alpha1.ScriptRunner, jobName string) *batchv1.Job {
	image := scriptRunner.Spec.Image
	if image == "" {
		image = DefaultImage
	}

	script := scriptRunner.Spec.Script
	if script == "" {
		script = DefaultScript
	}

	// Convert inputs to environment variables
	envVars := []corev1.EnvVar{}
	for key, value := range scriptRunner.Spec.Inputs {
		envVars = append(envVars, corev1.EnvVar{
			Name:  fmt.Sprintf("INPUT_%s", key),
			Value: value,
		})
	}

	// Add metadata about the ScriptRunner
	envVars = append(envVars, corev1.EnvVar{
		Name:  "SCRIPTRUNNER_NAME",
		Value: scriptRunner.Name,
	})
	envVars = append(envVars, corev1.EnvVar{
		Name:  "SCRIPTRUNNER_NAMESPACE",
		Value: scriptRunner.Namespace,
	})

	job := &batchv1.Job{
		ObjectMeta: metav1.ObjectMeta{
			Name:      jobName,
			Namespace: scriptRunner.Namespace,
			Labels: map[string]string{
				"app":                          "scriptrunner",
				"scriptrunner.io/name":         scriptRunner.Name,
				"scriptrunner.io/created-by":   "scriptrunner-controller",
			},
			OwnerReferences: []metav1.OwnerReference{
				*metav1.NewControllerRef(scriptRunner, scriptrunnerv1alpha1.SchemeGroupVersion.WithKind("ScriptRunner")),
			},
		},
		Spec: batchv1.JobSpec{
			Template: corev1.PodTemplateSpec{
				Spec: corev1.PodSpec{
					RestartPolicy: corev1.RestartPolicyNever,
					Containers: []corev1.Container{
						{
							Name:    "script-runner",
							Image:   image,
							Command: []string{"/bin/sh", "-c"},
							Args:    []string{script},
							Env:     envVars,
						},
					},
				},
			},
		},
	}

	return job
}

// updateScriptRunnerStatus updates the status of a ScriptRunner resource
func (c *Controller) updateScriptRunnerStatus(scriptRunner *scriptrunnerv1alpha1.ScriptRunner, jobName, phase, message string) error {
	// NEVER modify objects from the store. It's a read-only, local cache.
	// You can use DeepCopy() to make a deep copy of original object and modify this copy
	scriptRunnerCopy := scriptRunner.DeepCopy()
	scriptRunnerCopy.Status.JobName = jobName
	scriptRunnerCopy.Status.Phase = phase
	scriptRunnerCopy.Status.Message = message
	scriptRunnerCopy.Status.LastUpdateTime = metav1.Now()

	_, err := c.scriptrunnerClientset.ScriptrunnerV1alpha1().ScriptRunners(scriptRunner.Namespace).UpdateStatus(
		context.TODO(),
		scriptRunnerCopy,
		metav1.UpdateOptions{},
	)
	return err
}

// enqueueScriptRunner takes a ScriptRunner resource and converts it into a namespace/name
// string which is then put onto the work queue.
func (c *Controller) enqueueScriptRunner(obj interface{}) {
	var key string
	var err error
	if key, err = cache.MetaNamespaceKeyFunc(obj); err != nil {
		klog.Error(err)
		return
	}
	c.workqueue.Add(key)
}
