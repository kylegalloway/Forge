#!/usr/bin/env bash
# File generated by pre-commit: https://pre-commit.com
# ID: 138fd403232d2ddd5efb44317e38bf03

set -euo pipefail

MSG_FILE="$1"

TITLE="$(head -n 1 "$MSG_FILE")"
BODY="$(tail -n +2 "$MSG_FILE")"

# 1. Emoji required somewhere in title
# Use LC_ALL=C.UTF-8 to ensure proper UTF-8 handling
# macOS grep doesn't support -P, so we check for high Unicode bytes
# \xE2 = 3-byte UTF-8 start (covers ✨ ♻️ ⚡ ⬆️ ⬇️ and other symbols)
# \xF0 = 4-byte UTF-8 start (covers 🔧 🐛 📝 🚀 and most modern emoji)
if ! printf "%s" "$TITLE" | LC_ALL=C grep -q $'[\xE2\xF0]'; then
  echo "❌ Commit title must contain at least one emoji"
  exit 1
fi

# 2. Title length
if [ "${#TITLE}" -gt 72 ]; then
  echo "❌ Commit title exceeds 72 characters"
  exit 1
fi

# 3. Blank line after title
SECOND_LINE="$(sed -n '2p' "$MSG_FILE")"
if [ -n "$SECOND_LINE" ]; then
  echo "❌ Commit message must have a blank line after the title"
  exit 1
fi

# 4. No Claude / AI attribution (paranoid on purpose)
# Allow official Claude Code footer, but block other AI mentions in the main message
LINE_COUNT=$(wc -l < "$MSG_FILE" | tr -d ' ')
MAIN_LINE_COUNT=$((LINE_COUNT - 3))
MAIN_MSG="$(head -n "$MAIN_LINE_COUNT" "$MSG_FILE")"
if echo "$MAIN_MSG" | grep -qiE "claude|anthropic|ai generated|llm|chatgpt"; then
  echo "❌ Commit message contains forbidden attribution"
  exit 1
fi

# 5. Block boring conventional commits
if echo "$TITLE" | grep -qiE '^(fix|feat|chore|docs|refactor|test|style)(:|\b)'; then
  echo "❌ Boring commit detected. Chaos required."
  exit 1
fi

# 6. Require a real body (why, not what)
if [ -z "$(echo "$BODY" | tr -d '[:space:]')" ]; then
  echo "❌ Commit body is required (explain the *why*)"
  exit 1
fi

echo "✅ Commit message passed chaos checks"

# --- END CUSTOM COMMIT RULES -----------------------------------------------

# start templated
INSTALL_PYTHON=/opt/homebrew/opt/pre-commit/libexec/bin/python3.14
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=commit-msg)
# end templated

HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

if [ -x "$INSTALL_PYTHON" ]; then
    exec "$INSTALL_PYTHON" -mpre_commit "${ARGS[@]}"
elif command -v pre-commit > /dev/null; then
    exec pre-commit "${ARGS[@]}"
else
    echo '`pre-commit` not found.  Did you forget to activate your virtualenv?' 1>&2
    exit 1
fi
